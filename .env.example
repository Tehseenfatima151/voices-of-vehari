# ==========================================
# Voices of Vehari - Environment Configuration
# ==========================================

# Flask Environment & Secrets
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-for-flask
PORT=5000

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt
JWT_EXPIRES_HOURS=24

# Database Configuration
# Local development (SQLite):
DATABASE_URL=sqlite:///voices_of_vehari.db
# Production (PostgreSQL on Render/Railway/Supabase/Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS Configuration (Frontend origin URL)
# For local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For production (Vercel frontend domain):
# CORS_ORIGINS=https://voices-of-vehari.vercel.app

# Upload Storage Directory
UPLOAD_FOLDER=uploads

# Initial Default Administrator (Used during first seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@voicesofvehari.edu.pk
ADMIN_PASSWORD=AdminPassword2026!

# Frontend Environment (Set this in Vercel or frontend/.env.production)
# VITE_API_URL=https://your-backend-api.onrender.com
